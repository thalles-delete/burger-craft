        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.talisberado.burgercraft"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "65e5d1ad-53d6-4bc8-ae68-dcab535e3dbe"
      }
    },
    "owner": "talisberado"
  }
}
